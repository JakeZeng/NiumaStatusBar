<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+（Android 14）要求 foregroundServiceType=specialUse 时必须配套声明。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ai_model_monitor"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- ===== 桌面组件（AppWidget）=====
             1x2 横条 widget（1 行高 × 2 列宽）。v0.1.37 起只发布一个尺寸，
             早期 2x2 / 2x3 / 2x4 三种 receiver 全部移除。
             v0.1.39 起横条轮播显示所有 enabled provider，每 30 秒切换一次。
             widget 进程通过 SQLite 直读与主进程共享 usage_history 数据；
             主进程 storage.rs 已启用 WAL + busy_timeout 避免锁竞争。
             高频轮播由 [UsageWidgetCarouselService] 前台服务持有，规避系统
             30 分钟 updatePeriodMillis 限制。 -->
        <receiver
            android:name=".widget.UsageWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_one">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_info_1x2" />
        </receiver>

        <!-- v0.1.52+：2x2 环图 widget（与 1x2 横条并存）。
             Coding Plan 走 3 环布局（5H/1W/1M），余额型走单环布局。
             数据走 SQLite 直读 + 独立 carousel FGS。 -->
        <receiver
            android:name=".widget.RingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_ring">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_info_2x2" />
        </receiver>

        <!-- 1x2 widget 轮播服务：每 30 秒读 SQLite 渲染下一档 provider。
             foregroundServiceType=specialUse 是因为 widget 轮播不属于
             location/mediaProjection/dataSync 等任何一类标准 FGS 用途，
             且不联网传输；property 文本在审核侧用于解释该用途。 -->
        <service
            android:name=".widget.UsageWidgetCarouselService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Periodic home-screen widget refresh: read locally cached usage_history and rotate the displayed provider every 30 seconds. No network transfer, no user data leaves the device." />
        </service>

        <!-- v0.1.52+：2x2 环图 widget 轮播服务，与 1x2 carousel 平行存在。
             独立 FGS 实例、SharedPreferences、NotificationChannel，互不干扰。 -->
        <service
            android:name=".widget.RingWidgetCarouselService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Periodic home-screen widget refresh for 2x2 ring widget: read locally cached usage_history and rotate the displayed provider every 30 seconds. No network transfer, no user data leaves the device." />
        </service>
    </application>
</manifest>
