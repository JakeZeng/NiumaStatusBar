<?xml version="1.0" encoding="utf-8"?>
<!--
  NiumaStatusBar 自适应图标前景 — 数据脉冲徽章
  对应 src-tauri/icons/icon.svg 的矢量版本，居中于 108×108 视口。
  Android adaptive-icon 安全区约为中心 66dp（缩放后），所以脉冲宽度严格控制在
  视口宽度的 60% 以内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 脉冲线：基线 → 峰值 → 基线 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15,58 L38,58 L47,58 L52,74 L58,28 L64,74 L69,58 L78,58 L93,58"/>
    <!-- 端点圆点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15,58 m-3.8,0 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0"/>
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M93,58 m-3.8,0 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0"/>
</vector>