<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 中等组件。展示前 3 个 enabled Provider 的余额。
  Coding Plan 类型显示 5H/Week/Month 三档进度条（用 ImageView 的 level-list 模拟）。

  注：RemoteViews 不能动态加视图，所以两种模式（balance vs quota）由 Kotlin
  端在 onUpdate 时选 layout-id 渲染。中等组件只做"top-3 balance" 模式，
  因为同一 AppWidgetProvider 类对所有中等实例生效，要做"绑定的 provider"
  分支需要单独 Provider 类。折中：中等组件仅展示 top-3。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="Top 3 providers"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- 行 1 -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView
            android:id="@+id/widget_row_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Provider 1"
            xmlns:tools="http://schemas.android.com/tools" />
        <TextView
            android:id="@+id/widget_row_1_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="¥ 123.45"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <!-- 行 2 -->
    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView
            android:id="@+id/widget_row_2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Provider 2"
            xmlns:tools="http://schemas.android.com/tools" />
        <TextView
            android:id="@+id/widget_row_2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="¥ 67.89"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <!-- 行 3 -->
    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView
            android:id="@+id/widget_row_3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Provider 3"
            xmlns:tools="http://schemas.android.com/tools" />
        <TextView
            android:id="@+id/widget_row_3_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="¥ 12.00"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <!-- 底部：更新时间 + 更多提示 -->
    <TextView
        android:id="@+id/widget_updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"
        tools:text="更新于 12:34"
        xmlns:tools="http://schemas.android.com/tools" />
</LinearLayout>