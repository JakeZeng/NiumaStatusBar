<?xml version="1.0" encoding="utf-8"?>
<!--
  1x2 widget（1 行高 × 2 列宽，水平条形状，约 160dp × 40dp）：

  内部 vertical 两行：
    第 1 行：状态点 + 供应商名（左侧）+ 主数值（中，余额或 Coding Plan 周期 %）+ 页码（右，多 provider 时显示）
    第 2 行：quota 补充信息
              - Coding Plan：5h 剩余 % / 周剩余 / 月剩余（取前 2 项，用 │ 分隔）
              - 余额型：余额 + 使用百分比

  整个 widget 横铺 launcher 一行，节省垂直空间。

  v0.1.39 起：横条本身轮播所有 enabled provider，每 30 秒切换一次。
  单 provider 时 widget_page_index 默认 gone，不显示。

  v0.1.40 起：minWidth 从 180dp 调到 160dp，paddingHorizontal 从 10dp
  调到 8dp。原因：180dp / 80dp/格 ≈ 2.25，老 launcher / 第三方 launcher
  ceil 到 3 cells 显示为 1x3；160dp / 80dp/格 = 2 cells 稳定。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- 第 1 行：状态点 + 供应商名 + 主数值 + 页码 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_status_dot_pending"
            android:contentDescription="@string/widget_status_pending" />

        <TextView
            android:id="@+id/widget_provider_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_loading"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Provider" />

        <TextView
            android:id="@+id/widget_big_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="—"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            tools:text="¥128.50" />

        <!-- 轮播页码：多 provider 时显示 (1/3)，单 provider 时隐藏，省空间 -->
        <TextView
            android:id="@+id/widget_page_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:singleLine="true"
            android:visibility="gone"
            tools:text="1/3" />
    </LinearLayout>

    <!-- 第 2 行：quota 补充信息（Coding Plan 显示 5h% + 周%，余额型显示余额 + 使用%） -->
    <TextView
        android:id="@+id/widget_sub_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/widget_sub_loading"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="5H 78%  │  周 12.5" />

    <!-- 隐藏字段（保留以复用 setTextViewText 调用） -->
    <TextView
        android:id="@+id/widget_updated_at"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
