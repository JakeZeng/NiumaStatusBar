<?xml version="1.0" encoding="utf-8"?>
<!--
  1x2 widget（1 行高 × 2 列宽，水平条形状，约 160dp × 40dp）：

  v0.1.56 起改为 vertical 三行：
    第 1 行（~14dp）：状态点 + 供应商名（左）+ 页码（右，多 provider 时显示）
    第 2 行（weight=1，占满中间，~16dp）：主信息，14sp bold，gravity center
              - Coding Plan（minimax_* / volcengine_*）："5H 78%  │  Week 12.5"
              - 余额型（deepseek 等）："¥128.50"
              - 数据陈旧时改显示「更新于 N 分钟前」（沿用 v0.1.51 陈旧降级文案）
    第 3 行（~10dp）：相对更新时间（"刚刚" / "X 分钟前" / "X 小时前" / "X 天前"），
                       右对齐，8sp muted

  paddingVertical 由 4dp 调到 2dp 给第 3 行让出空间。
  Row 1 textSize 由 12sp 调到 11sp 让出 1dp 高度。
  Row 2 复用既有 widget_big_number id，Builder 直接 setTextViewText。

  v0.1.39 起横条本身轮播所有 enabled provider，每 30 秒切换一次。
  单 provider 时 widget_page_index 默认 gone，不显示。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp">

    <!-- 第 1 行：状态点 + 供应商名 + 页码 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_status_dot_pending"
            android:contentDescription="@string/widget_status_pending" />

        <TextView
            android:id="@+id/widget_provider_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_loading"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Provider" />

        <!-- 轮播页码：多 provider 时显示 (1/3)，单 provider 时隐藏，省空间 -->
        <TextView
            android:id="@+id/widget_page_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            android:singleLine="true"
            android:visibility="gone"
            tools:text="1/3" />
    </LinearLayout>

    <!-- 第 2 行：主信息（Coding Plan 显示 5H% + 周用量，余额型显示余额），
         weight=1 占满中间，14sp bold，比第 1/3 行字号大 -->
    <TextView
        android:id="@+id/widget_big_number"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="—"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="5H 78%  │  Week 12.5" />

    <!-- 第 3 行：相对更新时间（小字，右对齐） -->
    <TextView
        android:id="@+id/widget_updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/widget_text_muted"
        android:textSize="8sp"
        android:singleLine="true"
        tools:text="5 分钟前" />
</LinearLayout>
